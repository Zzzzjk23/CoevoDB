   "rule_id": "llm:subquery_wrap",
   "kind": "query_wrap",
   "template": "SELECT * FROM ({q}) AS llm_sub",
   "argument": "Wrapping the entire statement as a derived table preserves all rows and columns, including duplicates, because SELECT * projects every column from the subquery without filtering, aggregation, or changing bag semantics.",
